<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for Developer ID builds (docs/architecture/release.md §3).
     Process taps need only NSAudioCaptureUsageDescription; the mic chain reads the headset
     microphone, which the hardened runtime blocks without audio-input. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
